<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ClaudeSyncBar.Windows.Tests</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="../ClaudeSyncBar.Windows.Service/ClaudeSyncBar.Windows.Service.csproj" />
    <!-- The same shared-core contract tests the Ubuntu project runs. -->
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/AccountSwitchTests.cs" Link="Contracts/AccountSwitchTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/AuthRefreshTests.cs" Link="Contracts/AuthRefreshTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/CliBatchUpdaterTests.cs" Link="Contracts/CliBatchUpdaterTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/AuthVaultTests.cs" Link="Contracts/AuthVaultTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/ChromiumLocalStorageTests.cs" Link="Contracts/ChromiumLocalStorageTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/LoginProtocolTests.cs" Link="Contracts/LoginProtocolTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/UsagePreferencesMigrationTests.cs" Link="Contracts/UsagePreferencesMigrationTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/QuotaResetFormattingTests.cs" Link="Contracts/QuotaResetFormattingTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/TokenRateTests.cs" Link="Contracts/TokenRateTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/TestAuth.cs" Link="Contracts/TestAuth.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/WeeklyAnchorExecutionTests.cs" Link="Contracts/WeeklyAnchorExecutionTests.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.Core.Tests/WindowsFactAttribute.cs" Link="Contracts/WindowsFactAttribute.cs" />
    <!-- The app's usage model has no WinUI in it; the taskbar readout's numbers are tested here. -->
    <Compile Include="../ClaudeSyncBar.Windows.App/Model/Quota.cs" Link="App/Quota.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.App/Model/AppState.cs" Link="App/AppState.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.App/Model/ServiceClient.cs" Link="App/ServiceClient.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.App/Model/TaskbarUsage.cs" Link="App/TaskbarUsage.cs" />
    <Compile Include="../ClaudeSyncBar.Windows.App/Model/WeeklyPool.cs" Link="App/WeeklyPool.cs" />
  </ItemGroup>
  <!-- The askpass round trip runs the same exe the app ships. -->
  <Import Project="../ClaudeSyncBar.Windows.AskPass/ClaudeSyncBar.Windows.AskPass.targets" />
</Project>
