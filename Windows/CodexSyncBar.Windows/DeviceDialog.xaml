<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="CodexSyncBar_Windows.DeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SSH 장치 설정"
    PrimaryButtonText="저장"
    SecondaryButtonText="취소"
    DefaultButton="Primary">
    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="16" MinWidth="360">
            <TextBlock Text="접속할 장치와 인증 방식을 입력하세요." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="DisplayNameBox" Header="표시 이름" PlaceholderText="예: 개발 서버" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HostBox" Header="호스트" PlaceholderText="hostname 또는 IP" />
                <NumberBox x:Name="PortBox" Grid.Column="1" Header="포트" Value="22" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
            </Grid>
            <TextBox x:Name="UsernameBox" Header="사용자 이름" PlaceholderText="SSH 사용자" />
            <ComboBox x:Name="AuthenticationBox" Header="인증 방식" SelectedIndex="0" SelectionChanged="AuthenticationBox_SelectionChanged">
                <ComboBoxItem Content="기존 OpenSSH 설정" Tag="openSSHConfig" />
                <ComboBoxItem Content="개인 키 / SSH 인증서" Tag="privateKey" />
                <ComboBoxItem Content="비밀번호" Tag="password" />
            </ComboBox>
            <TextBlock x:Name="OpenSshHelp" Text="Windows OpenSSH의 설정과 SSH 에이전트에 등록된 키를 사용합니다." TextWrapping="Wrap" />
            <StackPanel x:Name="KeyPanel" Spacing="12" Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IdentityFileBox" Header="개인 키 경로" PlaceholderText="C:\Users\me\.ssh\id_ed25519" />
                <Button Grid.Column="1" Content="찾기" AutomationProperties.Name="SSH 개인 키 파일 선택" VerticalAlignment="Bottom" Click="BrowseIdentityButton_Click" />
            </Grid>
            <PasswordBox x:Name="PassphraseBox" Header="개인 키 암호 (선택)" PlaceholderText="암호화된 개인 키인 경우 입력" />
            <CheckBox x:Name="ClearPassphraseBox" Content="저장된 키 암호 삭제" />
            <Expander Header="고급 옵션" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CertificateFileBox" Header="SSH 인증서 경로 (선택)" PlaceholderText="C:\Users\me\.ssh\id_ed25519-cert.pub" />
                <Button Grid.Column="1" Content="찾기" AutomationProperties.Name="SSH 인증서 파일 선택" VerticalAlignment="Bottom" Click="BrowseCertificateButton_Click" />
            </Grid>
            </Expander>
            </StackPanel>
            <StackPanel x:Name="PasswordPanel" Spacing="12" Visibility="Collapsed">
            <PasswordBox x:Name="PasswordBox" Header="SSH 비밀번호" PlaceholderText="이 Windows 사용자만 사용할 수 있게 저장" />
            <CheckBox x:Name="ClearPasswordBox" Content="저장된 SSH 비밀번호 삭제" />
            </StackPanel>
            <CheckBox x:Name="EnabledBox" Content="저장 후 동기화 대상에 포함" IsChecked="False" />
            <TextBlock Text="새 장치나 연결 정보가 바뀐 장치는 저장 후 ‘설치 및 활성화’로 연결 검증을 해야 동기화됩니다." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
