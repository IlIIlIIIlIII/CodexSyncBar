<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="CodexSyncBar_Windows.ReadmeDemoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid x:Name="RootGrid" Padding="24" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Codex SyncBar" FontSize="24" FontWeight="SemiBold" />
        <Grid x:Name="PopoverPanel" Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="236" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="계정" FontSize="20" />
                    <ListBox x:Name="AccountPicker" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="AccountPicker_SelectionChanged" AutomationProperties.AutomationId="DemoAccountPicker">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Padding="8,16" Spacing="6">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MaskedEmail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="계정 추가" HorizontalAlignment="Stretch" IsEnabled="False" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="ActiveAccountText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Pro · 인증 정상" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="ApplyButton" Content="모든 장치에 적용" Click="ApplyButton_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="DemoApply" />
                            <TextBlock x:Name="UpdatedText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="5시간" />
                                    <TextBlock x:Name="SessionValue" FontSize="24" FontWeight="SemiBold" Foreground="#67C76B" />
                                    <ProgressBar x:Name="SessionBar" Maximum="100" Foreground="#67C76B" AutomationProperties.Name="5시간 잔여 사용량" />
                                    <TextBlock Text="3시간 후 초기화" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="주간" />
                                    <TextBlock x:Name="WeeklyValue" FontSize="24" FontWeight="SemiBold" Foreground="#60CDFF" />
                                    <ProgressBar x:Name="WeeklyBar" Maximum="100" AutomationProperties.Name="주간 잔여 사용량" />
                                    <TextBlock Text="4일 후 초기화" FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UsageText" TextWrapping="Wrap" FontSize="12" />
                            <Button Content="새로고침" Click="RefreshButton_Click" AutomationProperties.AutomationId="DemoRefresh" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="초기화권" FontSize="20" />
                            <TextBlock x:Name="CreditsText" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="다음 만료까지 7일 남음" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="연결된 장치" FontSize="20" />
                            <TextBlock Text="활성화한 장치에 선택한 계정을 함께 적용합니다." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DevicesText" TextWrapping="Wrap" LineHeight="28" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Codex CLI 관리" IsEnabled="False" />
                                <Button Content="모든 기기 CLI 업데이트" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel x:Name="SettingsPanel" Grid.Row="1" Spacing="20" Visibility="Collapsed" MaxWidth="680" HorizontalAlignment="Stretch">
            <TextBlock Text="설정" FontSize="28" FontWeight="SemiBold" />
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="시작 및 사용량 표시" FontSize="20" />
                    <CheckBox Content="Windows 로그인 시 자동 시작" />
                    <CheckBox Content="5시간 사용량 표시" IsChecked="True" />
                    <CheckBox Content="주간 사용량 표시" IsChecked="True" />
                    <TextBlock Text="트레이에 있어도 사용량은 약 5분마다 갱신됩니다." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="주간 초기화 후 자동 메시지" FontSize="20" />
                    <TextBlock Text="계정별로 켤 수 있으며 기본값은 꺼짐입니다. 주간 한도가 초기화된 후 아직 사용하지 않은 계정에 짧은 확인 메시지를 전송합니다." TextWrapping="Wrap" />
                    <CheckBox Content="개인 계정" />
                    <CheckBox Content="작업용 계정" />
                    <TextBlock Text="5시간 한도 초기화는 자동 전송 대상이 아닙니다." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Windows 위젯 보드에서 ‘Codex 사용량 및 계정’을 추가하면 사용량 확인과 계정 전환을 함께 사용할 수 있습니다." TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="예시 화면 · 가상 계정과 장치만 사용하는 데모입니다." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
