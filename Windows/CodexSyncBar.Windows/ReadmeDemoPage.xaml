<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CodexSyncBar_Windows.ReadmeDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B0E13">
    <Grid x:Name="RootGrid" MinWidth="720" MinHeight="520" Background="#0B0E13">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
            <StackPanel x:Name="PopoverPanel" Width="760" Padding="28" Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Codex SyncBar" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="계정·장치·사용량을 한 곳에서 관리" Foreground="#9AA3B2" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="2개 계정 · 3개 장치" Foreground="#9AA3B2" VerticalAlignment="Center" />
                </Grid>

                <Border Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="메인 계정" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="demo.main@example.com · Pro" Foreground="#9AA3B2" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="현재 사용 중" Foreground="#4ADE80" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="ChatGPT / Codex 사용량" Foreground="#9AA3B2" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="5시간" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Value="18" Maximum="100" Height="8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="18%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="주간" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Value="32" Maximum="100" Height="8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="32%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Spark 주간" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Value="5" Maximum="100" Height="8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="5%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="초기화권 3개 · 다음 만료 2일 8시간 후" Foreground="#9AA3B2" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="최근 30일 토큰" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="12.3M tokens · 72 requests" />
                            <TextBlock Text="예상 비용 $42.18" Foreground="#9AA3B2" />
                            <TextBlock Text="장치 3/3 연결됨" Foreground="#9AA3B2" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="장치 상태" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="이 PC · 메인 계정" />
                            <TextBlock Text="작업 서버 · 메인 계정" />
                            <TextBlock Text="빌드 서버 · 메인 계정" Foreground="#9AA3B2" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Cursor 브리지" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Codex provider 연결됨 · composer-2.5" />
                        <TextBlock Text="Thinking / Fast variant와 SSH 원격 동기화를 지원합니다." Foreground="#9AA3B2" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SettingsPanel" Width="760" Padding="28" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Codex SyncBar 설정" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Windows 저장 위치와 표시·자동화 설정" Foreground="#9AA3B2" />
                <Border Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="일반" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="설정·프로필  %LOCALAPPDATA%\\CodexSyncBar" Foreground="#9AA3B2" />
                        <TextBlock Text="Codex  %USERPROFILE%\\.codex" Foreground="#9AA3B2" />
                        <TextBlock Text="브라우저 로그인  Windows 기본 브라우저" Foreground="#9AA3B2" />
                        <CheckBox Content="Windows 로그인 시 자동 시작" IsChecked="True" />
                    </StackPanel>
                </Border>
                <Border Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="사용량 표시" FontSize="18" FontWeight="SemiBold" />
                        <CheckBox Content="Codex 5시간" IsChecked="True" />
                        <CheckBox Content="Codex 주간" IsChecked="True" />
                        <CheckBox Content="Spark 5시간" IsChecked="True" />
                        <CheckBox Content="Spark 주간" IsChecked="True" />
                    </StackPanel>
                </Border>
                <Border Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="주간 주기 고정" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="계정별 초기화 시 읽기 전용 anchor 요청을 자동 실행합니다." Foreground="#9AA3B2" TextWrapping="Wrap" />
                        <CheckBox Content="메인 계정" IsChecked="True" />
                        <CheckBox Content="서브 계정" IsChecked="False" />
                    </StackPanel>
                </Border>
                <Border Background="#151A23" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Cursor 모델" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="composer-2.5 · Thinking · Fast" />
                        <TextBlock Text="Windows DPAPI와 OpenSSH를 사용해 원격 장치를 관리합니다." Foreground="#9AA3B2" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
