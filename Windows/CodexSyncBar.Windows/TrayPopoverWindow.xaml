<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="CodexSyncBar_Windows.TrayPopoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="WindowSurface" RequestedTheme="Default" CornerRadius="12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Resources>
            <Style x:Key="TrayBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" /></Style>
            <Style x:Key="TrayCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></Style>
            <Style x:Key="TraySuccess" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" /></Style>
            <Style x:Key="TrayCaution" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
            <Style x:Key="TrayCritical" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
            <Style x:Key="TrayOnAccent" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}"><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" /></Style>
            <Style x:Key="TrayProgress" TargetType="ProgressBar"><Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" /></Style>
            <Style x:Key="TrayProgressCaution" TargetType="ProgressBar"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
            <Style x:Key="TrayProgressCritical" TargetType="ProgressBar"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Padding="20,16" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Codex SyncBar" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="TrayStatusText" Text="사용량을 확인하고 있습니다" Style="{StaticResource TrayCaption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="RefreshButton" Width="36" Height="36" Grid.Column="1" Padding="0" Click="RefreshButton_Click"
                        AutomationProperties.Name="사용량과 장치 새로고침" ToolTipService.ToolTip="새로고침"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="20,0,20,16" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" AutomationProperties.Name="계정과 사용량, 장치 상태" IsTabStop="True">
                <StackPanel Spacing="16">
                    <Border x:Name="BannerBorder" Padding="12" CornerRadius="8" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <TextBlock x:Name="BannerText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Style="{StaticResource TrayCaption}" />
                    </Border>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="선택한 계정" Style="{StaticResource TrayCaption}" />
                            <TextBlock x:Name="SelectedAliasText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SelectedEmailText" Style="{StaticResource TrayCaption}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AuthenticationText" Style="{StaticResource TrayCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                            <Border x:Name="ActiveBadge" Padding="8,4" CornerRadius="4" Visibility="Collapsed" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                <TextBlock Text="현재 적용" Style="{StaticResource TraySuccess}" />
                            </Border>
                            <TextBlock x:Name="PlanText" HorizontalAlignment="Right" Style="{StaticResource TrayCaption}" />
                        </StackPanel>
                    </Grid>
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="남은 사용량" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="UsageProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                    <TextBlock x:Name="UsageUpdatedText" Style="{StaticResource TrayCaption}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UsageMessageText" Style="{StaticResource TrayCaption}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <Grid x:Name="UsagePanel" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid>
                            <TextBlock x:Name="CreditsText" Style="{StaticResource TrayCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8D4;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Grid.Column="1" Text="초기화권" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ResetCreditCountText" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                            <TextBlock x:Name="ResetCreditsText" Style="{StaticResource TrayCaption}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ResetCreditDateText" Style="{StaticResource TrayCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="전환할 계정" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="AccountCountText" Grid.Column="1" Style="{StaticResource TrayCaption}" />
                        </Grid>
                        <StackPanel x:Name="AccountsPanel" Spacing="8" />
                        <TextBlock Text="계정을 선택한 뒤 아래 적용 버튼을 눌러 주세요." Style="{StaticResource TrayCaption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header><StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE770;" FontSize="16" /><TextBlock Text="연결된 장치" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DeviceCountText" Style="{StaticResource TrayCaption}" VerticalAlignment="Center" />
                        </StackPanel></Expander.Header>
                        <StackPanel x:Name="DevicesPanel" Spacing="8" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="20,12,20,8">
                <StackPanel Spacing="8">
                    <Button x:Name="ApplyButton" AutomationProperties.AutomationId="TrayApplyAccount" Style="{StaticResource AccentButtonStyle}" MinHeight="40"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ApplyButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="ApplyProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                            <FontIcon x:Name="ApplyIcon" Glyph="&#xE895;" FontSize="16" /><TextBlock x:Name="ApplyButtonText" Text="모든 장치에 적용" />
                        </StackPanel>
                    </Button>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <HyperlinkButton Content="계정 및 장치 관리" Click="OpenMainWindowButton_Click" HorizontalAlignment="Left" AutomationProperties.Name="전체 관리 창 열기" />
                        <Button Grid.Column="1" Width="36" Height="32" Padding="0" Click="ExitButton_Click" AutomationProperties.Name="Codex SyncBar 종료" ToolTipService.ToolTip="앱 종료"><FontIcon Glyph="&#xE7E8;" FontSize="16" /></Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
