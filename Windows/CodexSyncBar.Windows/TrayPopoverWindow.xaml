<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CodexSyncBar_Windows.TrayPopoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="WindowSurface"
        Background="#0F1116"
        BorderBrush="#343A46"
        BorderThickness="1"
        CornerRadius="12"
        RequestedTheme="Dark">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="15,13,12,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="Codex SyncBar"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#F7F8FA" />
                    <TextBlock
                        x:Name="TrayStatusText"
                        MaxWidth="275"
                        FontSize="10"
                        Foreground="#81899A"
                        Text="사용량을 준비하는 중…"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="RefreshButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Click="RefreshButton_Click"
                        AutomationProperties.Name="사용량과 장치 새로고침"
                        ToolTipService.ToolTip="사용량과 장치 새로고침">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button
                        Width="34"
                        Height="32"
                        Padding="0"
                        Click="OpenMainWindowButton_Click"
                        AutomationProperties.Name="전체 관리 창 열기"
                        ToolTipService.ToolTip="전체 관리 창 열기">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                Padding="13,0,13,10"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="9">
                    <Border
                        x:Name="BannerBorder"
                        Padding="10,7"
                        Background="#182238"
                        BorderBrush="#30486F"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="BannerText"
                            FontSize="10"
                            Foreground="#BFD8FF"
                            TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="2,1,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="13" CornerRadius="2" Background="#3B82F6" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#DDE3EC"
                            Text="계정" />
                        <TextBlock
                            x:Name="AccountCountText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="#697386" />
                    </Grid>
                    <StackPanel x:Name="AccountsPanel" Spacing="6" />

                    <Border
                        Padding="12"
                        Background="#171A21"
                        BorderBrush="#2A303B"
                        BorderThickness="1"
                        CornerRadius="11">
                        <Grid ColumnSpacing="11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="#2563EB">
                                <TextBlock
                                    Text="✦"
                                    FontSize="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        x:Name="SelectedAliasText"
                                        MaxWidth="175"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#F5F7FA"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        x:Name="ActiveBadge"
                                        Padding="6,2"
                                        Background="#143725"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <TextBlock Text="현재 사용 중" FontSize="8" FontWeight="SemiBold" Foreground="#4ADE80" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    x:Name="SelectedEmailText"
                                    FontSize="10"
                                    Foreground="#8C95A5"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="AuthenticationText"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#4ADE80" />
                            </StackPanel>
                            <TextBlock
                                x:Name="PlanText"
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#B4BDCB" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="12,10"
                        Background="#171A21"
                        BorderBrush="#2A303B"
                        BorderThickness="1"
                        CornerRadius="11">
                        <StackPanel Spacing="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="사용량" FontSize="11" FontWeight="SemiBold" Foreground="#E8ECF2" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                    <ProgressRing
                                        x:Name="UsageProgressRing"
                                        Width="12"
                                        Height="12"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="UsageUpdatedText"
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        Foreground="#697386" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="UsageMessageText"
                                FontSize="9"
                                Foreground="#8C95A5"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <StackPanel x:Name="UsagePanel" Spacing="9" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="11,9"
                        Background="#2A2415"
                        BorderBrush="#5A4820"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#4A3913">
                                <FontIcon Glyph="&#xE8C7;" FontSize="13" Foreground="#FBBF24" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="크레딧" FontSize="8" Foreground="#B9A46B" />
                                <TextBlock
                                    x:Name="CreditsText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#F8D66D"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ResetCreditsText"
                                Grid.Column="2"
                                MaxWidth="125"
                                VerticalAlignment="Center"
                                TextAlignment="Right"
                                FontSize="8"
                                Foreground="#A99C79"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Grid Margin="2,2,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="13" CornerRadius="2" Background="#22D3EE" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#DDE3EC"
                            Text="전체 장치" />
                        <TextBlock
                            x:Name="DeviceCountText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="#697386" />
                    </Grid>
                    <Border
                        Padding="11,5"
                        Background="#171A21"
                        BorderBrush="#2A303B"
                        BorderThickness="1"
                        CornerRadius="11">
                        <StackPanel x:Name="DevicesPanel" Spacing="0" />
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Padding="13,8,13,8" Background="#0F1116">
                <Button
                    x:Name="ApplyButton"
                    MinHeight="40"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#2563EB"
                    Click="ApplyButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            x:Name="ApplyProgressRing"
                            Width="14"
                            Height="14"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <FontIcon x:Name="ApplyIcon" Glyph="&#xE895;" FontSize="13" />
                        <TextBlock x:Name="ApplyButtonText" Text="선택 계정을 모든 장치에 적용" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid
                Grid.Row="3"
                MinHeight="42"
                Padding="12,5"
                Background="#151820"
                BorderBrush="#282D37"
                BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Padding="10,5"
                    Background="Transparent"
                    Click="OpenMainWindowButton_Click"
                    ToolTipService.ToolTip="계정·로그인·SSH 장치 설정">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="12" />
                        <TextBlock Text="전체 관리" FontSize="10" />
                    </StackPanel>
                </Button>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="8"
                    Foreground="#586171"
                    Text="아이콘을 다시 누르면 닫힙니다" />
                <Button
                    Grid.Column="2"
                    Width="34"
                    Height="30"
                    Padding="0"
                    Background="Transparent"
                    Foreground="#F87171"
                    Click="ExitButton_Click"
                    AutomationProperties.Name="Codex SyncBar 종료"
                    ToolTipService.ToolTip="Codex SyncBar 종료">
                    <FontIcon Glyph="&#xE7E8;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
