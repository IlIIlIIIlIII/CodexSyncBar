<?xml version="1.0" encoding="utf-8"?>
<!--
    SyncBar Fluent, Claude edition. WinUI theme resources are used as they are; this adds
    only the remaining-amount meter, the six account colours and the card styles.
    Meter and number colours say how much is left (success, caution, critical) and never
    follow the accent, which marks only the account in use and focus.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SyncBarMeterTrackBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="SyncBarMeterMutedBrush" Color="#47000000" />
            <SolidColorBrush x:Key="SyncBarCurrentBackgroundBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.08" />
            <SolidColorBrush x:Key="SyncBarCurrentBorderBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.30" />
            <SolidColorBrush x:Key="SyncBarAvatarBlueBackground" Color="#DCEBFF" />
            <SolidColorBrush x:Key="SyncBarAvatarBlueForeground" Color="#0052AD" />
            <SolidColorBrush x:Key="SyncBarAvatarTealBackground" Color="#D2F1F6" />
            <SolidColorBrush x:Key="SyncBarAvatarTealForeground" Color="#005E73" />
            <SolidColorBrush x:Key="SyncBarAvatarVioletBackground" Color="#E9E3FF" />
            <SolidColorBrush x:Key="SyncBarAvatarVioletForeground" Color="#5B3CC4" />
            <SolidColorBrush x:Key="SyncBarAvatarAmberBackground" Color="#FFEBC7" />
            <SolidColorBrush x:Key="SyncBarAvatarAmberForeground" Color="#7A4B00" />
            <SolidColorBrush x:Key="SyncBarAvatarRoseBackground" Color="#FFE0E6" />
            <SolidColorBrush x:Key="SyncBarAvatarRoseForeground" Color="#A3223F" />
            <SolidColorBrush x:Key="SyncBarAvatarGreenBackground" Color="#DDF3DF" />
            <SolidColorBrush x:Key="SyncBarAvatarGreenForeground" Color="#1B6B2B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SyncBarMeterTrackBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="SyncBarMeterMutedBrush" Color="#57FFFFFF" />
            <SolidColorBrush x:Key="SyncBarCurrentBackgroundBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.10" />
            <SolidColorBrush x:Key="SyncBarCurrentBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.30" />
            <SolidColorBrush x:Key="SyncBarAvatarBlueBackground" Color="#0A3A73" />
            <SolidColorBrush x:Key="SyncBarAvatarBlueForeground" Color="#A6DBFF" />
            <SolidColorBrush x:Key="SyncBarAvatarTealBackground" Color="#084452" />
            <SolidColorBrush x:Key="SyncBarAvatarTealForeground" Color="#8FE8F5" />
            <SolidColorBrush x:Key="SyncBarAvatarVioletBackground" Color="#33245E" />
            <SolidColorBrush x:Key="SyncBarAvatarVioletForeground" Color="#CFC2FF" />
            <SolidColorBrush x:Key="SyncBarAvatarAmberBackground" Color="#4A3310" />
            <SolidColorBrush x:Key="SyncBarAvatarAmberForeground" Color="#FFD591" />
            <SolidColorBrush x:Key="SyncBarAvatarRoseBackground" Color="#561A28" />
            <SolidColorBrush x:Key="SyncBarAvatarRoseForeground" Color="#FFB3C2" />
            <SolidColorBrush x:Key="SyncBarAvatarGreenBackground" Color="#1B3F22" />
            <SolidColorBrush x:Key="SyncBarAvatarGreenForeground" Color="#A8E6B0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SyncBarMeterTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SyncBarMeterMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SyncBarCurrentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyncBarCurrentBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarBlueBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarBlueForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarTealBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarTealForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarVioletBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarVioletForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarAmberBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarAmberForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarRoseBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarRoseForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarGreenBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SyncBarAvatarGreenForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- A row card, as Windows Settings lists its items. -->
    <Style x:Key="SyncBarRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <!-- A card that groups one subject. -->
    <Style x:Key="SyncBarCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SyncBarCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SyncBarGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <x:Double x:Key="SyncBarPageMaxWidth">1000</x:Double>

    <!-- Styles set from code: their ThemeResource values follow the element's theme. -->
    <Style x:Key="SyncBarSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SyncBarToneHealthy" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" /></Style>
    <Style x:Key="SyncBarToneWarning" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
    <Style x:Key="SyncBarToneCritical" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
    <Style x:Key="SyncBarToneMuted" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></Style>
    <Style x:Key="SyncBarAccentText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Style>
    <Style x:Key="SyncBarGlyphHealthy" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" /></Style>
    <Style x:Key="SyncBarGlyphWarning" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
    <Style x:Key="SyncBarGlyphCritical" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
    <Style x:Key="SyncBarGlyphMuted" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></Style>
    <Style x:Key="SyncBarGlyphAccent" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Style>

    <Style x:Key="SyncBarSegmentOff" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SyncBarMeterTrackBrush}" /></Style>
    <!-- Token counts are not amounts left: their bars stay neutral. -->
    <Style x:Key="SyncBarTokenBar" TargetType="Border"><Setter Property="Background" Value="{ThemeResource TextFillColorTertiaryBrush}" /></Style>
    <Style x:Key="SyncBarTokenTrack" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SyncBarMeterTrackBrush}" /></Style>
    <Style x:Key="SyncBarSegmentHealthy" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" /></Style>
    <Style x:Key="SyncBarSegmentWarning" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" /></Style>
    <Style x:Key="SyncBarSegmentCritical" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
    <Style x:Key="SyncBarSegmentMuted" TargetType="Rectangle"><Setter Property="Fill" Value="{ThemeResource SyncBarMeterMutedBrush}" /></Style>
    <Style x:Key="SyncBarSegmentUnknown" TargetType="Rectangle">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style x:Key="SyncBarCurrentRowStyle" TargetType="Border" BasedOn="{StaticResource SyncBarRowStyle}">
        <Setter Property="Background" Value="{ThemeResource SyncBarCurrentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SyncBarCurrentBorderBrush}" />
    </Style>
    <Style x:Key="SyncBarDivider" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>
    <Style x:Key="SyncBarCurrentRowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SyncBarCurrentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SyncBarCurrentBorderBrush}" />
    </Style>
    <Style x:Key="SyncBarSubRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="Padding" Value="56,10,16,10" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style x:Key="SyncBarKindTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style x:Key="SyncBarApplyBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SyncBarCurrentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SyncBarCurrentBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="36,14" />
    </Style>

    <Style x:Key="SyncBarPillAccent" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SyncBarCurrentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SyncBarCurrentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SyncBarPillSuccess" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" /></Style>
    <Style x:Key="SyncBarPillCaution" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" /></Style>
    <Style x:Key="SyncBarPillCritical" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" /></Style>
    <Style x:Key="SyncBarPillNeutral" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SyncBarAvatarBlue" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SyncBarAvatarBlueBackground}" /></Style>
    <Style x:Key="SyncBarAvatarTeal" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SyncBarAvatarTealBackground}" /></Style>
    <Style x:Key="SyncBarAvatarViolet" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SyncBarAvatarVioletBackground}" /></Style>
    <Style x:Key="SyncBarAvatarAmber" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SyncBarAvatarAmberBackground}" /></Style>
    <Style x:Key="SyncBarAvatarRose" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SyncBarAvatarRoseBackground}" /></Style>
    <Style x:Key="SyncBarAvatarGreen" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SyncBarAvatarGreenBackground}" /></Style>
    <Style x:Key="SyncBarAvatarBlueText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SyncBarAvatarBlueForeground}" /></Style>
    <Style x:Key="SyncBarAvatarTealText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SyncBarAvatarTealForeground}" /></Style>
    <Style x:Key="SyncBarAvatarVioletText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SyncBarAvatarVioletForeground}" /></Style>
    <Style x:Key="SyncBarAvatarAmberText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SyncBarAvatarAmberForeground}" /></Style>
    <Style x:Key="SyncBarAvatarRoseText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SyncBarAvatarRoseForeground}" /></Style>
    <Style x:Key="SyncBarAvatarGreenText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SyncBarAvatarGreenForeground}" /></Style>
</ResourceDictionary>
