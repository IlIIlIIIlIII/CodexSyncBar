#!/usr/bin/python3
"""Small libsecret fallback for desktops without the secret-tool executable."""
import base64
import sys


def main(arguments):
    attributes = {"application": "codex-syncbar", "purpose": "vault-key-v1"}
    lookup = ["lookup", "application", "codex-syncbar", "purpose", "vault-key-v1"]
    store = ["store", "--label=Codex SyncBar vault", *lookup[1:]]
    if arguments != lookup and arguments != store:
        return 64
    try:
        import gi
        gi.require_version("Secret", "1")
        from gi.repository import Secret

        # No schema filter: interoperates with items created by secret-tool.
        if arguments == lookup:
            value = Secret.password_lookup_sync(None, attributes, None)
            if value is None:
                return 1  # Missing item, deliberately no diagnostic.
            sys.stdout.write(value)
            return 0
        value = sys.stdin.read(4097)
        if len(value) > 4096 or len(base64.b64decode(value, validate=True)) != 32:
            raise ValueError("Invalid vault key")
        if not Secret.password_store_sync(None, attributes, Secret.COLLECTION_DEFAULT,
                                          "Codex SyncBar vault", value, None):
            raise RuntimeError("Secret Service did not store the item")
        return 0
    except Exception:
        # Do not expose a key, input, DBus payload, or exception diagnostics.
        sys.stderr.write("Secret Service is unavailable or locked.\n")
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
